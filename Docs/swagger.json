{
    "openapi": "3.0.0",
    "info": {
        "title": "API Catalogo de Maquiagem",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:3000",
            "description": "Servidor de desenvolvimento local da API"
        }
